variable "app_name" {
  description = "Application name"
  type        = string
}

variable "environment" {
  description = "Environment name (dev, staging, prod)"
  type        = string
}

variable "stripe_secret_key" {
  description = "Stripe secret API key. Leave empty and store it with `belt pay:setup <env>`"
  type        = string
  default     = ""
  sensitive   = true
}

variable "stripe_webhook_secret" {
  description = "Stripe webhook signing secret. Leave empty and store it with `belt pay:setup <env>`"
  type        = string
  default     = ""
  sensitive   = true
}
